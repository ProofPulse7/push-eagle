# Remix Shopify app (push-eagle) — copy to .env for local dev.
# On Vercel (push-eagle project): set DATABASE_URL to the same value (no quotes).

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_customers,write_products
SHOPIFY_APP_URL=https://push-eagle.vercel.app
SHOPIFY_WEB_DASHBOARD_URL=https://push-eagle-dashboard.vercel.app
SHOPIFY_DASHBOARD_SSO_SECRET=

# Neon production branch (pooler). Replace PASSWORD with your Neon role password.
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-weathered-wind-aogxzw4p-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
